{
  "name": "pai-cli",
  "version": "0.1.0",
  "description": "Multi-session host for the pi coding agent: host process + one worker per conversation, JSONL over stdio",
  "bin": {
    "pai": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "check": "oxlint && oxfmt --check . && tsc --noEmit && node scripts/check-import-boundary.mjs",
    "fmt": "oxfmt .",
    "build": "bun build src/cli.ts --minify --production --outdir dist --target=bun --tsconfig-override \"$PWD/tsconfig.build.json\"",
    "test": "bun test && bun test/smoke.mjs && bun test/e2e-mock/run.mjs && bun test/conformance/run.mjs",
    "e2e": "bun test/e2e.mjs",
    "e2e:mock": "bun test/e2e-mock/run.mjs",
    "e2e:multi": "bun test/e2e-multi.mjs",
    "e2e:compile": "bun test/compile-smoke.mjs",
    "ci": "npm run check && npm run build && npm run test",
    "conformance": "bun test/conformance/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@earendil-works/pi-agent-core": "file:../packages/agent",
    "@earendil-works/pi-ai": "file:../packages/ai",
    "@earendil-works/pi-coding-agent": "file:../packages/coding-agent",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  }
}
